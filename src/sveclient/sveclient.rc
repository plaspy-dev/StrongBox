IDR_MAINFRAME           ICON                    "res\\sveclient.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de sveclient"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "sveclient versión 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2006",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "Aceptar",IDOK,178,7,50,16,WS_GROUP
END

IDD_SVECLIENT_DIALOG DIALOGEX 0, 0, 344, 145
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "SDGFinger - Cliente"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "Aceptar",IDOK,165,120,50,16
    PUSHBUTTON      "Cancelar",IDCANCEL,113,120,50,16,WS_DISABLED
    GROUPBOX        "Base de datos",IDC_STATIC,7,40,246,63
    LTEXT           "Servidor",IDC_STATIC,13,54,28,8
    LTEXT           "Puerto",IDC_STATIC,153,52,22,8
    LTEXT           "Base de datos",IDC_STATIC,13,71,46,8
    LTEXT           "Usuario",IDC_STATIC,13,87,25,8
    LTEXT           "Contraseña",IDC_STATIC,153,87,38,8
    LTEXT           "",IDC_SESTADO,7,110,330,8
    LTEXT           "",IDC_SHUELLA,258,47,79,59
    EDITTEXT        IDC_ESERVIDOR,62,51,84,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EPUERTO,193,51,54,14,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_EBDATOS,62,68,84,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EUSUARIO,62,84,84,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_ECONTRASENA,193,84,54,14,ES_PASSWORD | ES_AUTOHSCROLL
    CONTROL         "Autonomo",IDC_CAUTONOMO,"Button",BS_AUTOCHECKBOX | WS_TABSTOP,153,71,93,10
    LTEXT           "",IDC_SMATRIZ,7,7,330,31,WS_BORDER
END

IDD_DLICENCIA DIALOGEX 0, 0, 234, 121
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Licencia"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    EDITTEXT        IDC_ESERIAL,49,75,178,14,ES_AUTOHSCROLL
    DEFPUSHBUTTON   "Aceptar",IDOK,60,100,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,116,100,50,14
    EDITTEXT        IDC_ESEMILLA,49,55,178,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Semilla",IDC_STATIC,12,58,22,8
    LTEXT           "Serial",IDC_STATIC,12,77,18,8
    CTEXT           "Bienvenido a SDGFinger control de acceso.\nA continuación ingrese el número de serial del producto\n si no conoce este número consulte a su proveedor.",IDC_STATIC,7,11,220,31
END

IDD_DPOPUP DIALOGEX 0, 0, 318, 27
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP
EXSTYLE WS_EX_TOPMOST
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "",IDC_SMATRIZ,0,0,318,27,WS_BORDER
END


