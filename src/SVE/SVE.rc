#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04e4"
        BEGIN
            VALUE "CompanyName", "SDG"
            VALUE "FileDescription", "Sistema de cajas fuertes"
            VALUE "FileVersion", "1.0.0.1"
            VALUE "InternalName", "SDGFingerSB.exe"
            VALUE "LegalCopyright", "SDG(c).  Reservados todos los derechos."
            VALUE "OriginalFilename", "SDGFingerSB.exe"
            VALUE "ProductName", "SDGFingerSB (Sistema de cajas fuertes)"
            VALUE "ProductVersion", "1.0.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
